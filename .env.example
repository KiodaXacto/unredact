# ─────────────────────────────────────────────
# Unredact — Environment Variables
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────

# ── App identity ──────────────────────────────
VITE_APP_NAME=Unredact
VITE_APP_URL=https://unredact.com
VITE_APP_VERSION=1.0.0

# ── Data paths (relative to public/) ─────────
# No trailing slash
VITE_DAILY_PUZZLE_BASE_URL=/data/puzzles
VITE_ARCHIVE_INDEX_URL=/data/archive-index.json
VITE_UNLIMITED_INDEX_URL=/data/unlimited-index.json

# ── Optional: Privacy-friendly analytics ─────
# Leave empty to disable analytics entirely.
# Use Plausible (self-hosted or cloud) domain:
VITE_PLAUSIBLE_DOMAIN=

# ── Feature flags ─────────────────────────────
# Set to "true" to enable in production
VITE_FEATURE_POS_COLORS=true
VITE_FEATURE_ARCHIVE=true
VITE_FEATURE_UNLIMITED=true
